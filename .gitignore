# ==========================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory


# ==========================================
# Temporary files
# ==========================================

*.tmp
*.temp
*.swp
*.swo
*.bak
*.old
*.orig


