# Blender
# ==========================================

# Archivos temporales de Blender
*.blend1
*.blend2
*.blend3
*.blend4
*.blend5

# Cache de simulaciones
*.bphys
*.mdd

# Carpetas de cache
__pycache__/


# ==========================================
# Generated / Exported files
# ==========================================

# Builds locales
build/
out/

# Archivos comprimidos generados temporalmente
*.zip
*.rar
*.7z


# ==========================================
# OS / Editor backups
# ==========================================

*.orig
*.rej