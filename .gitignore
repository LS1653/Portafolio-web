# ==========================================
# Node.js / NPM
# ==========================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs
logs/
*.log

# Dependency lock files
# NOTA: package-lock.json, yarn.lock y pnpm-lock.yaml
# SÍ deben subirse al repositorio.
# No ignorarlos.


# ==========================================
# Vite
# ==========================================

dist/
.vite/
*.local


# ==========================================
# Environment variables
# ==========================================

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ejemplo:
# .env.example
# SÍ puede subirse si solo contiene variables de ejemplo.


# ==========================================
# VS Code
# ==========================================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Si quieres compartir configuraciones específicas
# puedes conservar settings.json y extensions.json.


# ==========================================
